{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spark-learning.local/schemas/reference.structure.schema.json",
  "title": "Spark Encyclopedia Invariant Reference Structure",
  "description": "Language-invariant structural definition for the 13 encyclopedia sections and 30 entries.",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["id", "icon", "entries"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "icon": { "type": "string" },
          "description": { "type": "string" },
          "official_docs_url": { "type": "string" },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "tags",
                "syntax",
                "codigo_pyspark",
                "salida_consola",
                "diagrama_mermaid"
              ],
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } },
                "syntax": { "type": "string" },
                "description": { "type": "string" },
                "when_to_use": { "type": "string" },
                "edge_cases": { "type": "array", "items": { "type": "string" } },
                "codigo_pyspark": { "type": "string" },
                "salida_consola": { "type": "string" },
                "diagrama_mermaid": { "type": "string" },
                "official_docs_url": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
